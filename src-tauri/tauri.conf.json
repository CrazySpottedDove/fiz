{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fiz",
  "version": "0.3.6",
  "identifier": "com.fiz.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "fiz",
        "maximized": true,
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "*/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2NDI5RTlERUQ4ODk1OUMKUldTY2xZanRuWjVDdGtvdFZhNG1ib01jNkFZTkFLMDQ2M0pjam1NYTZ0Ukcvbm5JL3RHdElRRysK",
      "windows": {
        "installMode": "passive"
      },
      "endpoints": [
        "https://github.com/CrazySpottedDove/fiz/releases/download/updater/latest.json"
      ]
    }
  }
}
